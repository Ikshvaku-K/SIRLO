# ──────────────────────────────────────────
# Python
# ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ──────────────────────────────────────────
# Virtual Environments
# ──────────────────────────────────────────
venv/
env/
ENV/
.venv/
.env          # Real secrets — never commit this (use .env.example instead)

# ──────────────────────────────────────────
# Secrets & Credentials
# ──────────────────────────────────────────
*.json                          # Service account key files, GEE tokens, etc.
!package.json                   # (keep if ever using Node tooling)
secrets.yaml
secrets.yml
config.yaml                     # Populated config with real values
*.pem
*.key
*.p12
credentials                     # Raw GEE credential files

# Google Earth Engine OAuth token (stored locally by `earthengine authenticate`)
.config/earthengine/
~/.config/earthengine/

# ──────────────────────────────────────────
# Generated Data & Visualizations
# ──────────────────────────────────────────
data/raw/                       # Downloaded real GEE imagery (can be re-fetched)
data/processed/                 # Intermediate processed tensors
data/datasets/                  # Generated synthetic dataset archives

# Visualizations are generated by run_and_visualise.py — don't commit large binaries
data/viz/*.png
data/viz/*.gif
data/viz/*.jpg
data/viz/run_stats.json         # Auto-generated run stats

# ML model checkpoints & outputs
*.pt
*.pth
*.pkl
*.h5
*.ckpt
checkpoints/
runs/
outputs/
logs/
lightning_logs/
wandb/
mlruns/

# ──────────────────────────────────────────
# Jupyter Notebooks
# ──────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ──────────────────────────────────────────
# OS & Editor Noise
# ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────
# Testing & Coverage
# ──────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.cover

# ──────────────────────────────────────────
# Explicitly KEEP in version control
# ──────────────────────────────────────────
!.env.example                   # Template showing which env vars are needed
!config/dataset_config.yaml     # Committed config template (no secrets)
!data/viz/VISUALISATION_GUIDE.md  # Human-readable guide lives alongside output
